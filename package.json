{
  "name": "ramp-wms",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "start": "npm run start:prod --workspace=apps/api",
    "db:setup": "bash db/scripts/setup.sh",
    "db:dump": "bash db/scripts/dump.sh",
    "db:apply": "bash db/scripts/apply.sh",
    "db:reset": "bash db/scripts/reset.sh"
  },
  "devDependencies": {
    "turbo": "^2.0.4"
  }
}
